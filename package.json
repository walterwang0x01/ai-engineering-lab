{
	"name": "ai-engineering-lab",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "npm run assets:sync && vite dev",
		"build": "npm run assets:sync && vite build && node scripts/assert-fallback-base.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest run",
		"test": "npm run test:unit -- --run",
		"test:smoke": "npm run build && node e2e/smoke.mjs",
		"check:all": "npm run lint && npm run check && npm run test:unit && npm run test:smoke",
		"og": "node scripts/generate-og.mjs",
		"pyodide:sync": "node scripts/sync-pyodide.mjs",
		"notes:sync": "node scripts/sync-notes.mjs",
		"assets:sync": "npm run pyodide:sync && npm run notes:sync",
		"notes:review": "node scripts/review-questions.mjs"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/typography": "^0.5.19",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"@vitest/browser": "^4.1.10",
		"@vitest/browser-playwright": "^4.1.8",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"playwright": "^1.60.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.8",
		"vitest-browser-svelte": "^2.1.1"
	},
	"dependencies": {
		"@codemirror/lang-python": "6.2.1",
		"@codemirror/language": "6.12.4",
		"@codemirror/state": "^6.7.1",
		"@codemirror/view": "^6.43.8",
		"@lezer/highlight": "1.2.3",
		"codemirror": "6.0.2",
		"highlight.js": "^11.11.1",
		"katex": "^0.18.2",
		"marked": "^18.0.9",
		"mermaid": "^11.16.1",
		"pyodide": "314.0.3"
	}
}
